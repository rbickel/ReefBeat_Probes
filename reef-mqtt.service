[Unit]
Description=ReefSense pH and temperature MQTT bridge
Wants=network-online.target bluetooth.service
After=network-online.target bluetooth.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ReefBeat_Probes
EnvironmentFile=/home/pi/ReefBeat_Probes/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/ReefBeat_Probes/.venv/bin/python /home/pi/ReefBeat_Probes/reef_mqtt.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
